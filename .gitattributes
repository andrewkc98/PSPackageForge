# Normalise to LF in the repository, check out CRLF on Windows.
* text=auto

# PowerShell source is authored and consumed on Windows. Pinning CRLF on checkout keeps
# diffs clean and avoids Windows PowerShell 5.1 oddities with here-strings.
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf
*.wxs   text eol=crlf

# CI runs on windows-latest but the workflow file is parsed by GitHub, not by Windows.
*.yml   text eol=lf
*.md    text eol=lf

# Test fixtures are binary and must never be line-ending mangled -- their SHA256 is
# recorded in Tests/Fixtures/README.md and asserted by the suite.
*.msi   binary
*.exe   binary
*.wixpdb binary
